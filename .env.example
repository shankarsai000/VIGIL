# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# VIGIL — Environment Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ArmorIQ (containment governance). Modes: live | disabled (default) | local-demo.
#   live        ArmorIQ authorizes each quarantine. Needs a real key and a principal.
#   disabled    Nothing is contained automatically or by approval. Quarantine escalates.
#   local-demo  Fixed thresholds, labelled NOT ArmorIQ in the audit trail. Offline demos only.
ARMORIQ_MODE=disabled
ARMORIQ_API_KEY=
ARMORIQ_USER_EMAIL=
ARMORIQ_AGENT_ID=vigil-containment
ARMORIQ_CONTAINMENT_MCP_ID=vigil-containment
ARMORIQ_USE_PRODUCTION=true
AUDIT_LEDGER_PATH=backend/storage/audit_ledger.jsonl

# Write endpoints and the WebSocket need this key. Unset means they refuse to run (HTTP 503).
OPERATOR_API_KEY=
# Shared secret between the containment MCP server and VIGIL. Unset means containment callbacks are refused.
CONTAINMENT_SECRET=
VIGIL_INTERNAL_URL=http://127.0.0.1:8000

# Anthropic Claude API (for plain-English incident explanations)
# Leave empty for rule-based fallback explanations
ANTHROPIC_API_KEY=

# Database
VIGIL_DB_PATH=vigil.db
DATABASE_URL=postgresql://postgres:vigil_secure_password@postgres:5432/vigil_db
POSTGRES_DB=vigil_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=vigil_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Logging
VIGIL_LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Telegram Governed Runtime Infrastructure
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs with ADMIN role
TELEGRAM_ADMIN_IDS=

# Webhook URL for production mode (leave empty for polling)
TELEGRAM_WEBHOOK_URL=

# Use polling (true) or webhook (false) for Telegram
TELEGRAM_POLLING_MODE=true

# Overnight autonomous protection mode
TELEGRAM_SLEEP_MODE=false
