# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# VIGIL — Environment Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ArmorIQ Integration
# Set to "mock" for demo mode without a live ArmorIQ API
ARMORIQ_API_KEY=mock
ARMORIQ_BASE_URL=https://api.armoriq.ai

# Anthropic Claude API (for plain-English incident explanations)
# Leave empty for rule-based fallback explanations
ANTHROPIC_API_KEY=

# Database
VIGIL_DB_PATH=vigil.db
DATABASE_URL=postgresql://postgres:vigil_secure_password@postgres:5432/vigil_db
POSTGRES_DB=vigil_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=vigil_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Logging
VIGIL_LOG_LEVEL=INFO

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Telegram Governed Runtime Infrastructure
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs with ADMIN role
TELEGRAM_ADMIN_IDS=

# Webhook URL for production mode (leave empty for polling)
TELEGRAM_WEBHOOK_URL=

# Use polling (true) or webhook (false) for Telegram
TELEGRAM_POLLING_MODE=true

# Overnight autonomous protection mode
TELEGRAM_SLEEP_MODE=false
